[Unit]
Description=Solana Validator
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User=solana
LimitNOFILE=1000000
LogRateLimitIntervalSec=0


ExecStart=/opt/solana/solana-test-validator --log  --ledger /var/db/solana/test-ledger   -u localhost  --rpc-port 8899  --gossip-port 8001 --dynamic-port-range 8002-8021  --limit-ledger-size 10



[Install]
WantedBy=multi-user.target


